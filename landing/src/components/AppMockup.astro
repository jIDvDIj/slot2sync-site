---
/**
 * A stylized illustration of the app window, not a captured screenshot: it
 * mirrors the real sidebar/card layout and tokens (colors, radius, motion)
 * closely enough to set expectations without going stale every redesign.
 */
---

<div class="mockup" role="img" aria-label="Janela do Slot2Sync mostrando dois emuladores sincronizados e o painel de sincronização">
  <div class="mockup-window">
    <div class="mockup-titlebar">
      <span class="mockup-dot"></span>
      <span class="mockup-dot"></span>
      <span class="mockup-dot"></span>
    </div>
    <div class="mockup-body">
      <aside class="mockup-sidebar">
        <div class="mockup-brand">
          <img src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="18" height="18" />
          <span>Slot2Sync</span>
        </div>
        <div class="mockup-nav-item active">Visão geral</div>
        <div class="mockup-nav-item">Atividade</div>
        <div class="mockup-nav-section">Emuladores</div>
        <div class="mockup-nav-item">
          <span class="mockup-status success"></span>
          PPSSPP
        </div>
        <div class="mockup-nav-item">
          <span class="mockup-status accent"></span>
          PCSX2
        </div>
      </aside>
      <main class="mockup-content">
        <div class="mockup-toolbar">
          <span class="mockup-toolbar-title">Visão geral</span>
          <span class="mockup-sync-btn">
            <svg viewBox="0 0 24 24" width="14" height="14"><path d="M19.5 10.5A7.5 7.5 0 0 0 6 7.1L4.5 8.5M4.5 4.5v4h4M4.5 13.5A7.5 7.5 0 0 0 18 16.9l1.5-1.4M19.5 19.5v-4h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sincronizado
          </span>
        </div>
        <div class="mockup-cards">
          <div class="mockup-card">
            <div class="mockup-card-head">
              <strong>PPSSPP</strong>
              <span class="mockup-badge success">Pronto</span>
            </div>
            <div class="mockup-card-line"></div>
            <div class="mockup-card-line short"></div>
          </div>
          <div class="mockup-card">
            <div class="mockup-card-head">
              <strong>PCSX2</strong>
              <span class="mockup-badge accent">Em execução</span>
            </div>
            <div class="mockup-card-line"></div>
            <div class="mockup-card-line short"></div>
          </div>
        </div>
      </main>
    </div>
  </div>
</div>

<style>
  .mockup {
    width: 100%;
  }

  .mockup-window {
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-dialog);
    border: 1px solid var(--color-separator);
  }

  .mockup-titlebar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    background: var(--color-window);
    border-bottom: 1px solid var(--color-separator);
  }

  .mockup-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-separator);
  }

  .mockup-body {
    display: grid;
    grid-template-columns: 128px 1fr;
    min-height: 260px;
  }

  .mockup-sidebar {
    background: var(--color-window);
    border-right: 1px solid var(--color-separator);
    padding: var(--space-3);
    display: grid;
    align-content: start;
    gap: 3px;
  }

  .mockup-brand {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-label);
    margin-bottom: var(--space-3);
  }

  .mockup-brand img {
    border-radius: 4px;
  }

  .mockup-nav-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 6px;
    border-radius: 6px;
    font-size: 0.68rem;
    color: var(--color-label-secondary);
  }

  .mockup-nav-item.active {
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    font-weight: 600;
  }

  .mockup-nav-section {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-label-tertiary);
    margin: var(--space-2) 0 2px 6px;
  }

  .mockup-status {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .mockup-status.success {
    background: #34c759;
  }

  .mockup-status.accent {
    background: var(--color-accent);
  }

  .mockup-content {
    padding: var(--space-4);
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .mockup-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mockup-toolbar-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-label);
  }

  .mockup-sync-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .mockup-cards {
    display: grid;
    gap: var(--space-3);
  }

  .mockup-card {
    background: var(--color-window);
    border-radius: 10px;
    padding: var(--space-3);
    box-shadow: var(--shadow-raised);
  }

  .mockup-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    margin-bottom: var(--space-2);
  }

  .mockup-badge {
    font-size: 0.6rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .mockup-badge.success {
    background: color-mix(in srgb, #34c759 16%, transparent);
    color: #1f8a3b;
  }

  .mockup-badge.accent {
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .mockup-card-line {
    height: 6px;
    border-radius: 4px;
    background: var(--color-separator);
    margin-top: 6px;
    width: 100%;
  }

  .mockup-card-line.short {
    width: 55%;
  }

  @media (max-width: 480px) {
    .mockup-body {
      grid-template-columns: 96px 1fr;
    }
  }
</style>
