---
import Icon from './Icon.astro';

const features = [
  {
    icon: 'sync' as const,
    title: 'Sincroniza sozinho, na hora certa',
    text: 'Ao abrir o emulador, baixa os saves mais recentes antes do jogo começar. Ao fechar, envia o progresso novo para a nuvem.',
  },
  {
    icon: 'search' as const,
    title: 'Reconhece o emulador sozinho',
    text: 'Aponte a pasta do emulador e o Slot2Sync identifica qual é e onde ficam os saves, sem configuração manual de caminho.',
  },
  {
    icon: 'cloud' as const,
    title: 'Funciona offline',
    text: 'Sem internet ou com o jogo aberto na hora errada? Vira uma pendência resolvida assim que der, sem erro e sem travar.',
  },
  {
    icon: 'sliders' as const,
    title: 'Você escolhe o que sincronizar',
    text: 'Ligue ou desligue saves e savestates por emulador, e escolha quais momentos disparam a sincronização automática.',
  },
  {
    icon: 'bell' as const,
    title: 'Avisa sem incomodar',
    text: 'Notificações nativas mostram o que foi sincronizado ou o que deu errado, ajustáveis para todas, só erros, ou nenhuma.',
  },
  {
    icon: 'laptop' as const,
    title: 'Combina com várias máquinas',
    text: 'Cada computador ganha um nome, então você sempre sabe de onde veio cada save.',
  },
];
---

<section class="features" id="features">
  <div class="container">
    <p class="eyebrow">O que ele faz por você</p>
    <h2>Sincronização de verdade, sem trabalho manual</h2>
    <div class="grid grid-3">
      {
        features.map((f) => (
          <div class="card feature-card">
            <span class="feature-icon">
              <Icon name={f.icon} />
            </span>
            <h3>{f.title}</h3>
            <p class="muted">{f.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features .card {
    margin-top: var(--space-6);
  }

  .feature-card p {
    margin: 0;
  }

  .feature-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-3);
    border-radius: 12px;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }
</style>
