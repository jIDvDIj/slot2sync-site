---
import Icon from './Icon.astro';
import type { ReleaseData } from '../lib/release';

interface Props {
  release: ReleaseData;
}

const { release } = Astro.props;
const platforms = [release.platforms.windows, release.platforms.macArm, release.platforms.linux];
const RELEASES_PAGE = 'https://github.com/jIDvDIj/slot2sync/releases/latest';
---

<section class="download" id="download">
  <div class="container">
    <p class="eyebrow">Baixar</p>
    <h2>Escolha seu sistema</h2>
    <p class="muted">
      {release.version ? <>Versão mais recente: <strong>{release.version}</strong>. </> : null}
      Os botões abaixo baixam o instalador direto do repositório, sem redirecionamento e sem precisar de conta.
    </p>

    <div class="grid grid-3 platforms">
      {
        platforms.map((platform) => (
          <div class="card platform-card">
            <span class="platform-icon">
              <Icon name={platform.os} size={30} />
            </span>
            <h3>{platform.label}</h3>
            <a class="btn btn-primary" href={platform.url} aria-label={`Baixar Slot2Sync para ${platform.label}`}>
              <Icon name="download" size={18} />
              {platform.formatLabel}
            </a>
            <p class="platform-meta muted">{platform.sizeMb ? `${platform.sizeMb} MB` : 'Ver na página de releases'}</p>
            <p class="platform-alt">
              {platform.alternates.map((alt, i) => (
                <>
                  {i > 0 ? ' · ' : 'também: '}
                  <a href={alt.url}>{alt.label}</a>
                </>
              ))}
            </p>
          </div>
        ))
      }
    </div>

    <p class="muted all-downloads">
      Precisa do código-fonte ou quer conferir as assinaturas? <a href={RELEASES_PAGE}>Veja todos os arquivos da versão</a>.
    </p>
  </div>
</section>

<style>
  .platforms {
    margin-top: var(--space-8);
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .platform-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-1);
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .platform-card h3 {
    margin-bottom: var(--space-2);
  }

  .platform-card .btn {
    width: 100%;
    justify-content: center;
  }

  .platform-meta {
    margin: var(--space-2) 0 0;
    font-size: 0.85rem;
  }

  .platform-alt {
    margin: 0;
    font-size: 0.85rem;
  }

  .all-downloads {
    margin-top: var(--space-6);
    text-align: center;
  }
</style>
