---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <span class="muted">© {year} Slot2Sync — GPL-3.0-or-later</span>
    <nav>
      <a href={`${base}docs/`}>Documentação</a>
      <a href="https://github.com/jIDvDIj/slot2sync">GitHub</a>
      <a href="https://github.com/jIDvDIj/slot2sync/issues">Issues</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-separator);
    padding: var(--space-8) 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  nav {
    display: flex;
    gap: var(--space-5);
  }

  nav a {
    color: var(--color-label-secondary);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-label);
  }
</style>
