---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Onboarding from '../components/Onboarding.astro';
import Features from '../components/Features.astro';
import Emulators from '../components/Emulators.astro';
import Trust from '../components/Trust.astro';
import Faq from '../components/Faq.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import { loadRelease } from '../lib/release';

const release = await loadRelease();
---

<Base
  title="Slot2Sync: saves e savestates sincronizados na nuvem"
  description="Slot2Sync sincroniza automaticamente saves, savestates e configurações de emuladores de retrogames (PPSSPP, PCSX2) com o Google Drive, Dropbox ou OneDrive."
>
  <Hero release={release} />
  <Onboarding />
  <Features />
  <Emulators />
  <Trust />
  <Faq />
  <Download release={release} />
  <Footer />
</Base>
